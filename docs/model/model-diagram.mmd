%% PPTX Subagent System — Model Diagram (UML class diagram, domain model)
%% Render at https://mermaid.live (paste everything below the line)
%% Note: code uses a tagged dict (slide_type field), not OOP classes;
%% the generalization hierarchy is a conceptual domain model for clarity.
classDiagram
    direction LR

    class Deck {
        +List~Slide~ slides
    }

    class Slide {
        <<abstract>>
        +SlideType slide_type
        +str title
        +str notes
    }
    class TitleSlide {
        +str subtitle [0..1]
    }
    class ContentSlide {
        +str body [0..1]
    }
    class SectionHeaderSlide
    class TwoContentSlide {
        +str body_left [0..1]
        +str body_right [0..1]
    }
    class ComparisonSlide {
        +str body_left [0..1]
        +str body_right [0..1]
    }
    class ContentImageSlide {
        +str body [0..1]
        +str image_path [0..1]
        +str image_position [0..1]
        +dict image_size [0..1]
    }
    class ChartSlide {
        +ChartType chart_type
        +list categories
        +list series
        +str data_query [0..1]
        +str data_hint [0..1]
    }
    class ClosingSlide {
        +str subtitle [0..1]
    }

    Slide <|-- TitleSlide
    Slide <|-- ContentSlide
    Slide <|-- SectionHeaderSlide
    Slide <|-- TwoContentSlide
    Slide <|-- ComparisonSlide
    Slide <|-- ContentImageSlide
    Slide <|-- ChartSlide
    Slide <|-- ClosingSlide
    Deck "1" *-- "0..*" Slide : contains

    class ChartOptions {
        +str legend_position [0..1]
        +bool show_data_labels [0..1]
        +str value_format [0..1]
        +str y_axis_format [0..1]
        +float y_axis_min [0..1]
        +float y_axis_max [0..1]
        +float y_axis_major_unit [0..1]
        +str y_axis_title [0..1]
        +str x_axis_title [0..1]
    }
    ChartSlide "1" *-- "0..1" ChartOptions : styled by

    class SlideType {
        <<enumeration>>
        title_slide
        content_slide
        section_header_slide
        two_content_slide
        comparison_slide
        content_image_slide
        chart_slide
        closing_slide
    }
    class ChartType {
        <<enumeration>>
        bar
        bar_stacked
        bar_horizontal
        bar_horizontal_stacked
        pie
        pie_exploded
        doughnut
        line
        line_markers
    }

    class TemplateContract {
        +str working_file
        +str backup_file [0..1]
        +float working_mtime
        +TemplateRole role
        +SlideSize slide_size
        +Theme theme
        +List~Layout~ layouts
    }
    class SlideSize {
        +float width_in
        +float height_in
        +str ratio
    }
    class Theme {
        +dict colors
        +dict fonts
    }
    class Layout {
        +int index
        +str name
        +list fingerprint
        +float content_area_in2
        +LayoutOrigin origin
        +str added_at [0..1]
    }
    class TemplateBackup {
        +str original_path
        +str backup_path
        +datetime backed_up_at
    }
    class TemplateRole {
        <<enumeration>>
        original_backup
        working
    }
    class LayoutOrigin {
        <<enumeration>>
        native
        extended
    }
    TemplateContract "1" *-- "1" SlideSize
    TemplateContract "1" *-- "1" Theme
    TemplateContract "1" *-- "0..*" Layout
    TemplateContract "1" o-- "0..1" TemplateBackup : one-time snapshot
    Slide ..> Layout : matched by fingerprint

    note for Layout "Extended layouts (origin = extended) are injected as new ppt/slideLayouts/slideLayoutN.xml parts, wired into the slideMaster *.rels + [Content_Types].xml inside the working template.pptx zip."
