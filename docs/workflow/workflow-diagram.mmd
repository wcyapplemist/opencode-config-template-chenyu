%% PPTX Subagent System — Workflow Diagram (KEY steps · swimlane / responsibility view)
%% Replaces the previous version. For the simplest linear view see workflow-diagram-linear.mmd;
%% for the full mechanism see workflow-diagram-detailed.mmd.
%% Render at https://mermaid.live
flowchart LR
    subgraph User["👤 User"]
        U0([Request a deck<br/>+ optional template])
        U1[Confirm outline<br/>+ density mode]
        Uend([Receive .pptx])
    end

    subgraph Agent["pptx-subagent"]
        direction TB
        S0["Understand<br/>+ introspect template"]
        S1["Generate outline"]
        S2{"Context?"}
        S3["Author JSON<br/>+ validate (retry on error)"]
        S4["Resolve + render"]
        S5["Return result"]
        S0 --> S1 --> S2
        S3 --> S4 --> S5
    end

    subgraph Ext["template-modifier-skill"]
        X0{"Layout missing?"}
        X1[Clone extended layout<br/>→ template_new.pptx]
    end

    subgraph Engine["⚙️ generate-slide-skill"]
        E0[Fill template layouts<br/>→ native .pptx]
    end

    U0 --> S0
    S2 -->|"primary agent"| U1
    S2 -->|"headless subagent<br/>(auto = standard)"| S3
    U1 --> S3
    S4 --> X0
    X0 -->|"no"| E0
    X0 -->|"yes"| X1 --> E0
    E0 --> S5 --> Uend
