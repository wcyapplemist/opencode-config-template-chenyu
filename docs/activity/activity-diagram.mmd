%% PPTX Subagent System — Activity Diagram (generate-first control flow)
%% Complementary to workflow-diagram.mmd: decision branches + loops + per-slide render loop.
%% Chinese version: activity-diagram.zh.mmd
%% Render at https://mermaid.live
flowchart TD
    Start([User request]) --> Intent{"Intent?"}

    Intent -->|"extract only"| GT["Extract schema + embed"] --> EndExt([Templated PPTX])

    Intent -->|"generate"| SM1["Check template already templated"]
    SM1 --> S0a["Extract explicit requirements"]
    S0a --> S0b["Auto-decide unstated options"]
    S0b --> S1["Show outline (no approval)"]
    S1 --> S2["Self-critique outline"]
    S2 --> S3["Author slide JSON + webfetch chart data"]

    S3 --> Val["Validate (strict + density)"]
    Val --> ValD{"Valid?"}
    ValD -->|"INVALID"| S3
    ValD -->|"over-budget warning"| Tighten["Tighten prose to budget"] --> Val
    ValD -->|"VALID"| Resolve["Resolve placeholders"]

    Resolve --> TMD{"Layout missing?"}
    TMD -->|"yes"| Clone["Clone extended layout (template-modifier-skill)"]
    TMD -->|"no"| Load
    Clone --> Load["Load + repair template"]

    Load --> Intro["Introspect fingerprint contract"]
    Intro --> LoopD{"for each slide<br/>in slide_data_list"}
    LoopD -->|"next slide"| Slide["select layout, add_slide, fill placeholders, text-fit, notes"]
    Slide --> LoopD
    LoopD -->|"iteration done"| Save["Save deck"]

    Save --> Post["Re-embed schema + write render.json"]
    Post --> Mode{"Execution mode?"}

    Mode -->|"headless subagent"| End1([Return .pptx])
    Mode -->|"primary agent"| RefQ["Offer refinement question"]
    RefQ --> RefD{"User picks adjustments?"}
    RefD -->|"no adjustment"| End2([Return .pptx])
    RefD -->|"yes (one round)"| Apply["Apply refinements"]
    Apply --> Resolve
