{
  "_comment": "Copy to resolver.config.json and fill in. Gitignore keeps secrets out. Any unconfigured provider makes its resolver skip gracefully.",
  "image": {
    "provider": "pexels",
    "_provider_options": ["pexels", "unsplash", "ai"],
    "api_key_env": "PEXELS_API_KEY",
    "ai_model": "default",
    "cache_dir": "output/_image_cache",
    "default_position": "below-title"
  },
  "icon": {
    "library": "phosphor",
    "_library_options": ["phosphor"],
    "path": "assets/icons",
    "default_format": "png"
  },
  "chart_data": {
    "search": "webfetch",
    "max_results": 5,
    "cite_in_notes": true
  }
}
